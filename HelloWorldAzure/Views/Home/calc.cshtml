<!DOCTYPE html>
<html>
<head>
    <title>Simple Calculator</title>
</head>
<body>

    <h3>Simple HTML Calculator</h3>

    <!-- Inputs -->
    <input type="number" id="num1" placeholder="First number">
    <input type="number" id="num2" placeholder="Second number">

    <br>
    <br>

    <!-- Operation Buttons -->
    <button onclick="calculate('+')">+</button>
    <button onclick="calculate('-')">-</button>
    <button onclick="calculate('*')">*</button>
    <button onclick="calculate('/')">/</button>

    <br>
    <br>

    <!-- Output Display -->
    <h4>Result: <span id="result">0</span></h4>

    <script>
            function calculate(operator) {
                // Get values from inputs and convert to numbers
                const n1 = parseFloat(document.getElementById('num1').value) || 0;
                const n2 = parseFloat(document.getElementById('num2').value) || 0;
                let ans = 0;

                // Perform chosen operation
                if (operator === '+') ans = n1 + n2;
                if (operator === '-') ans = n1 - n2;
                if (operator === '*') ans = n1 * n2;
                if (operator === '/') {
                    ans = n2 === 0 ? "Cannot divide by zero!" : n1 / n2;
                }

                // Display the result
                document.getElementById('result').innerText = ans;
            }
    </script>

</body>
</html>
